{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-skills.local/schemas/ctf-research-intake-v1.json",
  "title": "CTF Skills V2 Research Intake Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pool", "challenge_id", "challenge_name", "category",
    "source", "pin", "difficulty", "technique_families", "exposure",
    "existing_routes", "methodology", "validation_evidence", "dependencies",
    "limitations", "provenance", "priority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pool": { "enum": ["DEVELOPMENT", "REGRESSION", "HELD-OUT"] },
    "challenge_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "challenge_name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["web", "pwn", "reverse", "crypto", "forensics", "osint", "malware", "misc", "boot2root", "ai-ml", "hybrid", "unknown"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_url", "writeup_urls"],
      "properties": {
        "challenge_url": { "type": "string", "minLength": 1 },
        "writeup_urls": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "artifact_sha256"],
      "properties": {
        "source_revision": { "type": ["string", "null"] },
        "artifact_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "difficulty": {
      "type": "object", "additionalProperties": false,
      "required": ["rating", "evidence"],
      "properties": {
        "rating": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "technique_families": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "pool_integrity", "evidence"],
      "properties": {
        "status": { "enum": ["public-solution-studied", "previously-exposed", "untouched"] },
        "pool_integrity": { "enum": ["none-known", "suspected-contamination", "confirmed-contamination"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "existing_routes": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route_id", "primary_skill", "reference"],
        "properties": {
          "route_id": { "type": "string", "minLength": 1 },
          "primary_skill": { "type": "string", "minLength": 1 },
          "reference": { "type": ["string", "null"] }
        }
      }
    },
    "methodology": {
      "type": "object", "additionalProperties": false,
      "required": ["missing", "reusable"],
      "properties": {
        "missing": { "type": ["string", "null"] },
        "reusable": { "type": ["string", "null"] }
      }
    },
    "validation_evidence": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "command", "result", "reproducible"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": ["string", "null"] },
          "result": { "type": ["string", "null"] },
          "reproducible": { "type": ["boolean", "null"] }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["attribution", "license", "retrieved_at"],
      "properties": {
        "attribution": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] }
      }
    },
    "priority": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["novelty", "capability_gap", "generalizability", "evidence_quality", "estimated_cost"],
      "properties": {
        "novelty": { "type": "integer", "minimum": 0, "maximum": 3 },
        "capability_gap": { "type": "integer", "minimum": 0, "maximum": 3 },
        "generalizability": { "type": "integer", "minimum": 0, "maximum": 3 },
        "evidence_quality": { "type": "integer", "minimum": 0, "maximum": 3 },
        "estimated_cost": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  }
}
